      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "timescaledb"
          },
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT\n  $__timeGroupAlias(time,'5s'),\n  hostname AS metric,\n  avg(diff_per_sec) AS \"RX Packets/s\"\nFROM (\n  SELECT\n    time,\n    n.hostname,\n    (rx_packets - lag(rx_packets) OVER (PARTITION BY m.node_id ORDER BY time)) /\n    NULLIF(extract(epoch from (time - lag(time) OVER (PARTITION BY m.node_id ORDER BY time))), 0) AS diff_per_sec\n  FROM timesync.network_metrics m\n  JOIN timesync.nodes n ON n.node_id = m.node_id\n  WHERE $__timeFilter(time) AND n.hostname ~ '${node:pipe}'\n) sub\nWHERE diff_per_sec >= 0\nGROUP BY 1, 2\nORDER BY 1",
          "refId": "A"
        }
      ],
      "title": "RX Packets/s",
      "type": "timeseries"
    },

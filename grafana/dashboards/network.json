          "datasource": {"type": "postgres", "uid": "timescaledb"},
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT\n  $__timeGroupAlias(time,'5s'),\n  n.hostname AS metric,\n  avg(rx_packets) AS \"RX Packets\"\nFROM timesync.network_metrics m\nJOIN timesync.nodes n ON n.node_id = m.node_id\nWHERE $__timeFilter(time) AND n.hostname ~ '${node:pipe}'\nGROUP BY 1, 2\nORDER BY 1",
          "refId": "A"
        }
      ],
      "title": "RX Packets",
      "type": "timeseries"

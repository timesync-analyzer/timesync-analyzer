          "editorMode": "code",
          "format": "time_series",
          "interval": "3s",
          "rawQuery": true,
          "rawSql": "SELECT\n  $__timeGroupAlias(time,'$__interval'),\n  n.hostname AS metric,\n  avg(offset_ns) AS \"Offset (ns)\"\nFROM timesync.ptp4l_metrics m\nJOIN timesync.nodes n ON n.node_id = m.node_id\nWHERE $__timeFilter(time) AND n.hostname ~ '${node:pipe}'\nGROUP BY 1, 2\nORDER BY 1",
          "refId": "A",

      },
      "targets": [
        {
          "datasource": {"type": "postgres", "uid": "timescaledb"},
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT\n  $__timeGroupAlias(tm.time,'15s'),\n  n.hostname || ' — ' || s.sensor_label AS metric,\n  avg(tm.temperature) AS \"Temperature (°C)\"\nFROM timesync.temperature_metrics tm\nJOIN timesync.sensors s ON s.sensor_id = tm.sensor_id\nJOIN timesync.nodes n ON n.node_id = s.node_id\nWHERE $__timeFilter(tm.time) AND n.hostname ~ '${node:pipe}'\nGROUP BY 1, 2\nORDER BY 1",
          "refId": "A"
        }
      ],
      "title": "Temperature",

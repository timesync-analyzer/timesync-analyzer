          "rawQuery": true,
          "rawSql": "SELECT\n  $__timeGroupAlias(time,'15s'),\n  n.hostname AS metric,\n  avg(context_switches) AS \"Context Switches\"\nFROM timesync.cpu_metrics m\nJOIN timesync.nodes n ON n.node_id = m.node_id\nWHERE $__timeFilter(time) AND n.hostname ~ '${node:pipe}'\nGROUP BY 1, 2\nORDER BY 1",
          "refId": "A"
        }
      ],
      "title": "Context Switches",
      "type": "timeseries"
    },

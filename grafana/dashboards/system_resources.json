          "rawQuery": true,
          "rawSql": "SELECT\n  $__timeGroupAlias(time,'15s'),\n  n.hostname AS metric,\n  avg(mem_available_kb) / 1024 AS \"Available (MB)\"\nFROM timesync.memory_metrics m\nJOIN timesync.nodes n ON n.node_id = m.node_id\nWHERE $__timeFilter(time) AND n.hostname ~ '${node:pipe}'\nGROUP BY 1, 2\nORDER BY 1",
          "refId": "A"

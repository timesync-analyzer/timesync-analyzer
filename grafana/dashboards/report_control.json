          "icon": "cloud-upload",
          "text": "Сформировать отчёт",
          "variant": "primary"
        },
        "sync": true,
        "update": {
          "code": "(async () => {\n  const r = context.panel.response;\n  const notify = (level, title, msg) => {\n    const g = context.grafana;\n    if (!g) return;\n    const fn = g['notify' + level];\n    if (typeof fn === 'function') fn([title, msg || '']);\n  };\n  if (!r) { notify('Error', 'Запрос отчёта', 'Нет ответа от сервера'); return; }\n  let body = null;\n  try {\n    body = r.data !== undefined ? r.data : (typeof r.json === 'function' ? await r.json() : null);\n  } catch (e) { console.error('parse response failed', e); }\n  const job = body && body.job;\n  if (!job || !job.id) { notify('Error', 'Запрос отчёта', 'Не удалось получить ID задачи'); return; }\n  const base = '/api/datasources/proxy/uid/reportd';\n  const statusUrl = base + '/api/reports/' + job.id;\n  const pdfUrl = base + '/api/reports/' + job.id + '/summary.pdf';\n  notify('Success', 'Отчёт', 'Задача ' + job.id + ' поставлена в очередь, ожидаю готовности...');\n  const downloadBlob = async (url, filename) => {\n    const resp = await fetch(url, { credentials: 'include', headers: { 'Accept': 'application/pdf,application/octet-stream,*/*' } });\n    if (!resp.ok) throw new Error('HTTP ' + resp.status);\n    const blob = await resp.blob();\n    const objUrl = URL.createObjectURL(blob);\n    const a = document.createElement('a');\n    a.href = objUrl;\n    a.download = filename;\n    a.rel = 'noopener';\n    a.style.display = 'none';\n    document.body.appendChild(a);\n    a.click();\n    setTimeout(() => { document.body.removeChild(a); URL.revokeObjectURL(objUrl); }, 1000);\n  };\n  for (let i = 0; i < 180; i++) {\n    await new Promise((res) => setTimeout(res, 2000));\n    let j;\n    try {\n      const resp = await fetch(statusUrl, { headers: { 'Accept': 'application/json' }, credentials: 'include' });\n      if (!resp.ok) continue;\n      j = await resp.json();\n    } catch (e) { console.error('poll failed', e); continue; }\n    if (j.status === 'done') {\n      try {\n        await downloadBlob(pdfUrl, 'report-' + job.id + '.pdf');\n        notify('Success', 'Отчёт готов', 'PDF скачивается');\n      } catch (e) {\n        console.error('download failed', e);\n        notify('Error', 'Не удалось скачать PDF', String(e && e.message || e));\n      }\n      return;\n    }\n    if (j.status === 'failed') { notify('Error', 'Ошибка отчёта', j.error || ''); return; }\n  }\n  notify('Warning', 'Отчёт', 'Истёк таймаут ожидания готовности');\n})();",
          "confirm": false,
          "contentType": "application/json",
          "getPayload": "const elements = context.panel.elements;\nconst get = (id) => elements.find((el) => el.id === id)?.value;\nconst period = get('period');\nconst payload = {\n  node: get('node') || '.*',\n  groups: get('groups') || [],\n  skip_charts: !!get('skip_charts'),\n  charts_per_page: Number(get('charts_per_page')) || 3,\n  source: get('source') || 'manual',\n  reason: get('reason') || ''\n};\nif (period === 'custom') {\n  if (get('from')) payload.from = get('from');\n  if (get('to')) payload.to = get('to');\n} else {\n  payload.period = period;\n}\nreturn payload;",
